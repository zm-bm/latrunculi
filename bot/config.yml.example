# run-local.sh supplies LICHESS_BOT_TOKEN.
token: "set-via-LICHESS_BOT_TOKEN"
url: "https://lichess.org/"

engine:
  # Paths are resolved from the sibling lichess-bot checkout.
  dir: "../latrunculi/build/release"
  name: "latrunculi"
  protocol: "uci"
  ponder: true
  uci_options:
    Threads: 4
    Hash: 256
  draw_or_resign:
    resign_enabled: false
    offer_draw_enabled: false

# Begin conservatively: one standard game at a time, no ultrafast games, and
# no automatic outgoing challenges.
challenge:
  concurrency: 1
  accept_bot: true
  only_bot: false
  min_base: 60
  max_base: 1800
  min_increment: 0
  max_increment: 20
  variants:
    - standard
    - fromPosition
  time_controls:
    - blitz
    - rapid
    - classical
  modes:
    - casual
    - rated

correspondence: {}
matchmaking:
  allow_matchmaking: false
greeting:
  hello: "Hi! I'm {me}, running the Latrunculi chess engine. Good luck!"
  goodbye: "Good game!"

abort_time: 30
move_overhead: 2000
quit_after_all_games_finish: true
pgn_directory: "../latrunculi/bot/games"
pgn_file_grouping: "game"

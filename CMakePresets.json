{
  "version": 4,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_TESTING": "OFF",
        "LATRUNCULI_BUILD_BENCHMARK": "OFF",
        "LATRUNCULI_TUNING": "OFF",
        "LATRUNCULI_SEARCH_STATS": "OFF",
        "LATRUNCULI_SANITIZER": "none"
      }
    },
    {
      "name": "debug-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "release-dev",
      "inherits": "release",
      "displayName": "Release development",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "LATRUNCULI_BUILD_BENCHMARK": "ON"
      }
    },
    {
      "name": "release-tuning",
      "inherits": "release-dev",
      "displayName": "Release tuning",
      "cacheVariables": {
        "LATRUNCULI_TUNING": "ON"
      }
    },
    {
      "name": "debug-asan-ubsan",
      "inherits": "debug-base",
      "displayName": "Address and undefined behavior sanitizers",
      "cacheVariables": {
        "LATRUNCULI_SANITIZER": "address-undefined"
      }
    },
    {
      "name": "debug-tsan",
      "inherits": "debug-base",
      "displayName": "Thread sanitizer",
      "cacheVariables": {
        "LATRUNCULI_SANITIZER": "thread"
      }
    },
    {
      "name": "profile",
      "inherits": "release",
      "displayName": "Release CPU profiling",
      "cacheVariables": {
        "LATRUNCULI_BUILD_BENCHMARK": "ON",
        "CMAKE_CXX_FLAGS_RELEASE": "-O3 -DNDEBUG -g"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build-base",
      "hidden": true,
      "jobs": 2
    },
    {
      "name": "release",
      "inherits": "build-base",
      "configurePreset": "release"
    },
    {
      "name": "release-dev",
      "inherits": "build-base",
      "configurePreset": "release-dev"
    },
    {
      "name": "release-tuning",
      "inherits": "build-base",
      "configurePreset": "release-tuning"
    },
    {
      "name": "debug-asan-ubsan",
      "inherits": "build-base",
      "configurePreset": "debug-asan-ubsan"
    },
    {
      "name": "debug-tsan",
      "inherits": "build-base",
      "configurePreset": "debug-tsan"
    },
    {
      "name": "profile",
      "inherits": "build-base",
      "configurePreset": "profile",
      "targets": [
        "latrunculi-benchmark"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "execution": {
        "noTestsAction": "error",
        "jobs": 1
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release-dev",
      "inherits": "test-base",
      "configurePreset": "release-dev"
    },
    {
      "name": "release-tuning",
      "inherits": "test-base",
      "configurePreset": "release-tuning"
    },
    {
      "name": "debug-asan-ubsan",
      "inherits": "test-base",
      "configurePreset": "debug-asan-ubsan",
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:halt_on_error=1",
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
      }
    },
    {
      "name": "debug-tsan",
      "inherits": "test-base",
      "configurePreset": "debug-tsan",
      "environment": {
        "TSAN_OPTIONS": "halt_on_error=1"
      }
    }
  ]
}

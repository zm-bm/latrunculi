{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "debug",
      "inherits": ["base"],
      "displayName": "Debug",
      "description": "Debug build using the system default C++ compiler",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "debug-dev",
      "inherits": ["debug"],
      "displayName": "Debug Developer",
      "description": "Debug build with tests and component measurements enabled",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "LATRUNCULI_BUILD_MEASUREMENTS": "ON"
      }
    },
    {
      "name": "debug-asan-ubsan",
      "inherits": ["debug-dev"],
      "displayName": "Debug with AddressSanitizer and UndefinedBehaviorSanitizer",
      "description": "Debug developer build with address and undefined behavior sanitizers",
      "cacheVariables": {
        "LATRUNCULI_SANITIZER": "address-undefined"
      }
    },
    {
      "name": "debug-tsan",
      "inherits": ["debug-dev"],
      "displayName": "Debug with ThreadSanitizer",
      "description": "Debug developer build with the thread sanitizer",
      "cacheVariables": {
        "LATRUNCULI_SANITIZER": "thread"
      }
    },
    {
      "name": "release",
      "inherits": ["base"],
      "displayName": "Release",
      "description": "Release build using the system default C++ compiler",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "release-dev",
      "inherits": ["release"],
      "displayName": "Release Developer",
      "description": "Release build with tests and component measurements enabled",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "LATRUNCULI_BUILD_MEASUREMENTS": "ON"
      }
    },
    {
      "name": "release-stats",
      "inherits": ["base"],
      "displayName": "Release with search stats",
      "description": "Release build with search stats diagnostics enabled",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "LATRUNCULI_SEARCH_STATS": "ON"
      }
    },
    {
      "name": "release-stats-dev",
      "inherits": ["release-stats"],
      "displayName": "Release with search stats Developer",
      "description": "Release build with search stats, tests, and component measurements enabled",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "LATRUNCULI_BUILD_MEASUREMENTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "release-stats",
      "configurePreset": "release-stats"
    },
    {
      "name": "debug-dev",
      "configurePreset": "debug-dev"
    },
    {
      "name": "debug-asan-ubsan",
      "configurePreset": "debug-asan-ubsan"
    },
    {
      "name": "debug-tsan",
      "configurePreset": "debug-tsan"
    },
    {
      "name": "release-dev",
      "configurePreset": "release-dev"
    },
    {
      "name": "release-stats-dev",
      "configurePreset": "release-stats-dev"
    }
  ],
  "testPresets": [
    {
      "name": "debug-dev",
      "configurePreset": "debug-dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "debug-asan-ubsan",
      "configurePreset": "debug-asan-ubsan",
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:halt_on_error=1",
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "debug-tsan",
      "configurePreset": "debug-tsan",
      "environment": {
        "TSAN_OPTIONS": "halt_on_error=1"
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release-dev",
      "configurePreset": "release-dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release-stats-dev",
      "configurePreset": "release-stats-dev",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
